# VISTA CCTV frontend configuration
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Everything here is NEXT_PUBLIC_*, meaning it is inlined into the JavaScript
# bundle and visible to anyone who opens the site. Never put a secret here —
# in particular never the Supabase service role key.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key.
#
# This key is public, so what it can reach is governed entirely by Row Level
# Security. backend/sql/005_rls.sql must be applied, or this key can read and
# write every table directly through PostgREST, bypassing the API and all of
# its role checks.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the Express backend.
#   local:  http://localhost:4000
#   hosted: the Render service URL
NEXT_PUBLIC_API_URL=http://localhost:4000
