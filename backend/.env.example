# VISTA CCTV backend configuration
# Copy to .env and fill in the required values. .env is gitignored.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key. Bypasses Row Level Security, so it must never reach the
# browser or be committed. Use the anon key in the frontend instead.
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# DEPLOYMENT
# ---------------------------------------------------------------------------

# Port to listen on. Default 4000.
PORT=4000

# Number of proxy hops to trust for client IP resolution.
#
# REQUIRED IN HOSTED ENVIRONMENTS (Render, any load balancer). Behind a proxy
# every request arrives from the proxy's address, so without this the rate
# limiters bucket all users together and real users throttle each other.
# Set to 1 on Render. Leave unset for local runs.
#
# It is opt-in rather than always on because blanket proxy trust lets a client
# spoof X-Forwarded-For and evade rate limiting entirely.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# SESSION CACHE
# ---------------------------------------------------------------------------

# How long a verified session is cached, in milliseconds. Default 30000.
#
# Without caching, every authenticated request costs two Supabase round trips
# (token verification plus the profile lookup) before the endpoint does any of
# its own work — about 200ms of a 500ms response.
#
# TRADE-OFF: a role change or deactivation is observed up to this long after
# the fact. Admin actions (update, reset password, deactivate, reactivate)
# invalidate the affected user immediately, but only on the instance that
# handled the request — other instances still age out on this TTL.
# Set to 0 to disable caching entirely.
AUTH_CACHE_TTL_MS=30000

# Maximum cached sessions before the least recently used is evicted.
AUTH_CACHE_MAX_ENTRIES=1000

# ---------------------------------------------------------------------------
# RATE LIMITS  (all per client IP; see middleware/rateLimit.js)
# ---------------------------------------------------------------------------

# Short window, 1 minute. Catches bursts.
RATE_LIMIT_BURST=300

# Long window, 15 minutes. Catches slow sustained scraping.
RATE_LIMIT_SUSTAINED=2000

# 15 minutes. Applies to creating/updating users, password resets,
# deactivation and reactivation, and POST /api/auth/register.
#
# Applied per-route, NOT across the whole /api/users prefix: mounting it on the
# prefix also throttled GET /api/users/technicians, which the Create JO page
# reads on every load, so the technician dropdown silently emptied after 40
# page loads.
RATE_LIMIT_ACCOUNT=40

# 1 minute. Every call to /api/jo/generate permanently consumes a number from
# the yearly JO sequence, so this is capped tightly.
RATE_LIMIT_JO_GENERATE=30

# 15 minutes. Proof uploads are buffered in memory before forwarding.
RATE_LIMIT_UPLOAD=120

# ---------------------------------------------------------------------------
# UPLOADS
# ---------------------------------------------------------------------------

# Maximum signed-proof upload size in bytes. Default 5242880 (5MB), which is
# what the frontend advertises. Keep them in step.
MAX_PROOF_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# SEED SCRIPTS (optional — only read by npm run seed-*)
# Defaults shown. Rotate these passwords immediately after first setup.
# ---------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=admin
SEED_ADMIN_ROLE=admin

SEED_TECHNICIAN_EMAIL=technician@gmail.com
SEED_TECHNICIAN_PASSWORD=technician123
SEED_TECHNICIAN_NAME=technician

SEED_INVENTORY_EMAIL=inventory@gmail.com
SEED_INVENTORY_PASSWORD=inventory123
SEED_INVENTORY_NAME=inventory

# Only read by scripts/backfill-job-order-receiver.js
BACKFILL_TECHNICIAN_EMAIL=technician@taguig.gov
